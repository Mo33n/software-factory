{
  "concurrency": 1,
  "auto_merge": false,
  "max_rounds": 3,
  "base_branch": "main",
  "merge_method": "merge",
  "agent_timeout": "45m",
  "docs_dir": "docs/programs",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "omp": {
    "bin": "omp",
    "config": "factory/omp.yml"
  },
  "roles": {
    "intake": "smol",
    "spec-writer": "slow",
    "builder": "default",
    "approver": "slow",
    "researcher": "slow",
    "planner": "slow"
  },
  "routing": {
    "low":    { "code": "smol" },
    "medium": { "code": "default" },
    "high":   { "code": "slow" }
  },
  "surface_reviewers": {
    "ui": { "ux": "default", "ui": "smol" },
    "security": { "security": "slow" }
  },
  "models": {
    "smol": "ollama/qwen3-16k:latest",
    "default": "ollama/qwen3-16k:latest",
    "slow": "ollama/qwen3:14b"
  },
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/omp.yml",
    "factory/agents/*",
    "factory/bin/*",
    "factory/accept.sh",
    "factory/contract/*"
  ],
  "ports": { "base": 5100, "step": 10 }
}
