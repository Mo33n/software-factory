#!/usr/bin/env python3
"""The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job-id>            write round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate <job-id> --merge    same, as round-N/merge-checks.md (job merge runs it)
  gate --nudge <job-id>    before a READY build is accepted: exit 2 when checks,
                           accept.sh, or a protected path would fail the gate.
                           Writes no round report. The orchestrator sends the
                           builder back once with this output.
  gate --hook              same check, fed a Claude Code Stop event on stdin

The gate runs the main checkout's factory/checks.sh inside the job's worktree,
so a branch can't change the checks it is judged by. It also fails when the
branch modifies or deletes a file matching config.json `protected_paths`
(fnmatch patterns, where `*` also matches `/`). Adding new files is fine.
"""

import fnmatch
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(os.environ.get("FACTORY_REPO") or Path(__file__).resolve().parents[2])
FACTORY = REPO / "factory"
CONFIG = json.loads((FACTORY / "config.json").read_text())
CHECKS = FACTORY / "checks.sh"
ACCEPT = FACTORY / "accept.sh"
TAIL = 80


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True)
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def protected_changes(worktree):
    """Existing files under protected_paths that the branch modified or deleted."""
    diff = git(worktree, "diff", "--name-status", f"origin/{CONFIG['base_branch']}...HEAD")
    hits = []
    for line in diff.splitlines():
        status, *paths = line.split("\t")
        if status.startswith("A"):
            continue
        old = paths[0]  # for renames and copies, the original path
        if any(fnmatch.fnmatch(old, pattern) for pattern in CONFIG["protected_paths"]):
            hits.append(f"{status[0]} {old}")
    return hits


def run_script(script, worktree):
    """Run a script from the main checkout. The worktree cannot swap the file."""
    if not script.exists():
        return 0, "", 0
    start = time.monotonic()
    res = subprocess.run(["bash", str(script)], cwd=worktree, capture_output=True, text=True)
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def path_matches(path, pattern):
    """`**` matches across directories. `*` matches inside one path segment."""
    escaped = re.escape(pattern).replace(r"\*\*", ".*").replace(r"\*", "[^/]*")
    return re.fullmatch(escaped, path) is not None


def ticket_touches(job):
    """Area names from the issue body. Empty when the ticket names none."""
    text_path = FACTORY / "jobs" / job["id"] / "issue.md"
    if not text_path.exists():
        return []
    found = []
    for line in text_path.read_text().splitlines():
        if line.startswith("> "):
            line = line[2:]
        if line.lower().startswith("touches:"):
            raw = line.split(":", 1)[1]
            found = [part.strip() for part in raw.split(",") if part.strip() and part.strip().lower() != "none"]
    return found


def claim_patterns(touches):
    """Globs the ticket may change, or None when the map does not cover it.

    No `areas` map, or an area the map does not name, means the gate does not
    enforce paths. A partial map would fail tickets planned before it existed.
    """
    areas = CONFIG.get("areas") or {}
    if not touches or not areas:
        return None
    patterns = list(CONFIG.get("shared_paths") or [])
    for area in touches:
        mapped = areas.get(area)
        if not mapped:
            return None
        patterns.extend(mapped)
    return patterns


def outside_claim(worktree, touches, ignore=()):
    """Files in the branch diff that the ticket's areas do not cover.

    `ignore` is for a file the factory itself committed, such as the memory
    note written after the builder finished. The builder's own gate does not
    pass that list, so a builder cannot hide work there.
    """
    patterns = claim_patterns(touches)
    if patterns is None:
        return []
    skipped = set(ignore or [])
    diff = git(worktree, "diff", "--name-only", f"origin/{CONFIG['base_branch']}...HEAD")
    return [
        path for path in diff.splitlines()
        if path and path not in skipped and not any(path_matches(path, pattern) for pattern in patterns)
    ]


def run_checks(worktree):
    return run_script(CHECKS, worktree)


def run_accept(worktree):
    return run_script(ACCEPT, worktree)


def run_contract(worktree):
    """Shipped tests plus the page smoke. A project accept.sh cannot skip this."""
    script = FACTORY / "bin" / "contract"
    if not script.exists():
        script = Path(__file__).resolve().parent / "contract"
    if not script.exists():
        return 0, "", 0
    env = os.environ.copy()
    env["FACTORY_REPO"] = str(REPO)
    start = time.monotonic()
    res = subprocess.run(["bash", str(script)], cwd=worktree, capture_output=True, text=True, env=env)
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def gate(job_id, merge):
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    worktree = job["worktree"]
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    round_dir = FACTORY / "jobs" / job_id / f"round-{job['round']}"
    commit = git(worktree, "rev-parse", "HEAD").strip()
    protected = protected_changes(worktree)
    # The memory note is committed after the builder's gate, and only the merge
    # gate should accept that one factory-owned file.
    note = f"factory/memory/{job_id}.md"
    outside = outside_claim(worktree, ticket_touches(job), ignore=[note] if merge else ())
    code, log, seconds = run_checks(worktree)
    accept_code, accept_log, accept_seconds = run_accept(worktree)
    contract_code, contract_log, contract_seconds = run_contract(worktree)
    verdict = "PASS" if code == 0 and accept_code == 0 and contract_code == 0 and not protected and not outside else "FAIL"
    name = "merge-checks" if merge else "checks"
    (round_dir / f"{name}.log").write_text(
        log
        + ("\n# accept.sh\n" + accept_log if accept_log else "")
        + ("\n# contract\n" + contract_log if contract_log else "")
    )
    tail = "\n".join((log + "\n" + accept_log + "\n" + contract_log).rstrip().splitlines()[-TAIL:])
    summary = [
        f"checks.sh {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s",
        f"accept.sh {'passed' if accept_code == 0 else f'failed with exit {accept_code}'} in {accept_seconds}s"
        + ("" if ACCEPT.exists() else " (no accept.sh)"),
        f"contract {'passed' if contract_code == 0 else f'failed with exit {contract_code}'} in {contract_seconds}s",
        f"Protected paths: {'changed: ' + ', '.join(protected) if protected else 'none changed'}",
        f"Outside the ticket's areas: {', '.join(outside) if outside else 'none'}",
        f"Commit {commit[:7]}" + (", synced with the latest main before merging" if merge else ""),
    ]
    (round_dir / f"{name}.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\n\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + "\n\n## Outside the ticket's areas\n"
        + ("\n".join(f"- {p}" for p in outside) if outside else "None.")
        + f"\n\n## checks.sh\nExit {code} in {seconds}s. Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n"
    )
    if contract_code != 0:
        sys.stderr.write(contract_log)
    print(f"GATE: {verdict} ({job_id} round {job['round']}, checks.sh exit {code} in {seconds}s, "
          f"accept.sh exit {accept_code} in {accept_seconds}s, "
          f"contract exit {contract_code} in {contract_seconds}s"
          + (f", protected paths changed: {', '.join(protected)}" if protected else "")
          + (f", outside claimed areas: {', '.join(outside)}" if outside else "") + ")")
    sys.exit(0 if verdict == "PASS" else 1)


def failing_message(job):
    """Why this worktree would fail the gate, or None when it would pass.

    Does not write the round report. The real gate still decides.
    """
    worktree = job["worktree"]
    protected = protected_changes(worktree)
    outside = outside_claim(worktree, ticket_touches(job))
    code, log, _ = run_checks(worktree)
    accept_code, accept_log, _ = run_accept(worktree)
    contract_code, contract_log, _ = run_contract(worktree)
    problems = []
    if code != 0:
        problems.append(f"factory/checks.sh fails in your worktree (exit {code}).")
    if accept_code != 0:
        problems.append(f"factory/accept.sh fails in your worktree (exit {accept_code}).")
    if contract_code != 0:
        problems.append(f"factory/bin/contract fails in your worktree (exit {contract_code}).")
    if protected:
        problems.append("Protected paths changed: " + ", ".join(protected) + ".")
    if outside:
        allowed = ", ".join(claim_patterns(ticket_touches(job)) or [])
        problems.append(
            "These files are outside the areas this ticket claims: " + ", ".join(outside)
            + f". Allowed paths: {allowed}. Put a new test in a new file that matches one of them."
        )
    if not problems:
        return None
    tail = "\n".join((log + "\n" + accept_log + "\n" + contract_log).rstrip().splitlines()[-40:])
    return (
        " ".join(problems)
        + " The gate will reject this build. Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n"
        + tail
    )


def nudge(job_id):
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    message = failing_message(job)
    if message:
        print(message, file=sys.stderr)
        sys.exit(2)


def hook():
    event = json.load(sys.stdin)
    if event.get("stop_hook_active"):
        sys.exit(0)  # one nudge per stop; the gate decides
    with open(Path(event["agent_transcript_path"]).expanduser()) as f:
        content = json.loads(f.readline())["message"]["content"]
    prompt = content if isinstance(content, str) else " ".join(b.get("text", "") for b in content)
    job_id = prompt.split("Job: ", 1)[1].split(".", 1)[0]
    nudge(job_id)


def main(argv):
    if argv == ["--hook"]:
        hook()
    elif len(argv) == 2 and argv[0] == "--nudge":
        nudge(argv[1])
    elif len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0], merge=False)
    elif len(argv) == 2 and argv[1] == "--merge":
        gate(argv[0], merge=True)
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
